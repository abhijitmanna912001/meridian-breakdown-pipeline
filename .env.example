# Copy this file to .env and fill in real values. .env is gitignored.
# NOTE: Prisma ORM 7 does not auto-load .env files — prisma.config.ts
# and src/lib/db.ts both explicitly `import "dotenv/config"` to load this.

# SQLite — a local file, created automatically by `npm run db:migrate`
DATABASE_URL="file:./dev.db"

# Gemini (Google AI Studio) free-tier key — primary LLM provider, used for:
#   (a) extracting structured fields from messy free-text (maintenance notes, emails)
#   (b) drafting the client notification message text
# The rules engine and eligibility logic do NOT call the LLM — see src/rules/.
# Free tier has a low daily request quota per model (as low as 20/day on
# some models) — expect it to run out mid-batch on a 41-document pass.
GEMINI_API_KEY=""

# OpenAI key — FALLBACK provider, used automatically when Gemini fails
# (quota exhausted, rate limited, or erroring) so extraction can keep
# going without manual intervention. At this project's document volume
# (~41 short files), full-run cost on gpt-4o-mini is a fraction of a
# cent — effectively free against typical account credit.
OPENAI_API_KEY=""

# Path to the challenge's read-only input bundle (candidate_bundle folder).
# Kept as a config value, not hardcoded, so the surprise file at hour 7
# can be pointed at without touching source code.
CANDIDATE_BUNDLE_PATH="../candidate_bundle"
