# Copy this file to .env and fill in real values. .env is gitignored.
# NOTE: Prisma ORM 7 does not auto-load .env files — prisma.config.ts
# and src/lib/db.ts both explicitly `import "dotenv/config"` to load this.

# SQLite — a local file, created automatically by `npm run db:migrate`
DATABASE_URL="file:./dev.db"

# Gemini (Google AI Studio) free-tier key — used only for:
#   (a) extracting structured fields from messy free-text (maintenance notes, emails)
#   (b) drafting the client notification message text
# The rules engine and eligibility logic do NOT call the LLM — see src/rules/.
GEMINI_API_KEY=""

# Path to the challenge's read-only input bundle (candidate_bundle folder).
# Kept as a config value, not hardcoded, so the surprise file at hour 7
# can be pointed at without touching source code.
CANDIDATE_BUNDLE_PATH="../candidate_bundle"
