{
  "name": "meridian-breakdown-pipeline",
  "version": "1.0.0",
  "description": "Breakdown-to-resolution automation pipeline for Meridian Freight (Synq AI FDE Challenge)",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "ingest": "tsx src/ingest/run.ts",
    "extract-knowledge": "tsx src/knowledge/run.ts",
    "pipeline": "tsx src/pipeline/run.ts",
    "query": "tsx src/query/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:reset": "prisma migrate reset --force",
    "db:studio": "prisma studio",
    "setup": "npm install && npm run db:generate && npm run db:migrate"
  },
  "dependencies": {
    "@google/genai": "^2.19.0",
    "@libsql/client": "0.8.1",
    "@prisma/adapter-libsql": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "csv-parse": "^5.5.6",
    "dotenv": "^16.4.5",
    "openai": "^4.77.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "prisma": "^7.9.1",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1"
  },
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "prisma@7.10.0": true,
    "@prisma/engines@7.10.0": true,
    "esbuild@0.28.2": true,
    "esbuild@0.21.5": true
  }
}
